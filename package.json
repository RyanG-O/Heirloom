{
  "name": "heirloom",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck -w client && npm run typecheck -w server",
    "setup-git-hooks": "git config core.hooksPath .githooks",
    "sync-agent": "tsx scripts/sync-agent.ts",
    "agent-eval": "tsx scripts/agent-eval.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=22.12"
  }
}
