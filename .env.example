# Copy to .env (never commit .env). Server reads this file from the repo root.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional: Neon Postgres connection string (Neon track)
DATABASE_URL=
PORT=8787
# Optional: comma-separated Gemini models to try when GEMINI_MODEL is rate-limited/unavailable
# (free tier is ~20 requests/day per model; enable billing in AI Studio before the demo)
GEMINI_FALLBACK_MODELS=
