# Copy to .env (never commit .env). Server reads this file from the repo root.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
GEMINI_API_KEY=
# From the @google/genai SDK docs at install time; confirm in Google AI Studio.
GEMINI_MODEL=gemini-3.8-flash
# Optional: Neon Postgres connection string (Neon track)
DATABASE_URL=
PORT=8787
